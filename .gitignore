# ============================================================
# NetFault AI - Root Git Ignore
# ============================================================


# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------

node_modules/
**/node_modules/


# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.example.*


# ------------------------------------------------------------
# Build / Distribution
# ------------------------------------------------------------

dist/
**/dist/

build/
**/build/

out/
**/out/

coverage/
**/coverage/

.vite/
**/.vite/

.cache/
**/.cache/


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# TypeScript
# ------------------------------------------------------------

*.tsbuildinfo


# ------------------------------------------------------------
# Prisma
# ------------------------------------------------------------

# Prisma-generated agent/IDE skills
backend/.agents/
backend/.claude/
backend/.windsurf/

# Prisma generated client
# Regenerated with:
# npx prisma generate
backend/src/generated/


# ------------------------------------------------------------
# Python / AI Service
# ------------------------------------------------------------

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/

# Python packaging
*.egg
*.egg-info/

# Python test / cache tools
.pytest_cache/
**/.pytest_cache/

.mypy_cache/
**/.mypy_cache/

.ruff_cache/
**/.ruff_cache/

.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/


# ------------------------------------------------------------
# AI / ML Generated Files
# ------------------------------------------------------------

# Trained model binaries
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.joblib
*.pkl
*.pickle
*.safetensors
*.bin

# Local datasets
*.csv
*.parquet
*.feather
*.npy
*.npz

# Experiment output
experiments/output/
experiments/results/

# Generic model directories
models/
checkpoints/
artifacts/

# ------------------------------------------------------------
# NetFault AI model metadata
# ------------------------------------------------------------

# Keep the NetFault AI models directory visible to Git
!ai-service/models/

# Keep feature importance metadata in Git
!ai-service/models/feature_importance.json

# Trained model binaries remain ignored
ai-service/models/*.joblib


# ------------------------------------------------------------
# Temporary / Generated Data
# ------------------------------------------------------------

tmp/
**/tmp/

temp/
**/temp/

*.tmp
*.temp


# ------------------------------------------------------------
# Network Simulator Generated Data
# ------------------------------------------------------------

simulator/output/
simulator/data/
simulator/logs/

ai-service/simulator/output/
ai-service/simulator/data/
ai-service/simulator/logs/


# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------

.vscode/
**/.vscode/

.idea/
**/.idea/

*.swp
*.swo
*~

.project
.classpath
.settings/


# ------------------------------------------------------------
# Operating System
# ------------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini


# ------------------------------------------------------------
# Frontend Specific
# ------------------------------------------------------------

frontend/.vite/
frontend/dist/
frontend/build/
frontend/coverage/


# ------------------------------------------------------------
# Backend Specific
# ------------------------------------------------------------

backend/dist/
backend/build/
backend/coverage/


# ------------------------------------------------------------
# Local Development Files
# ------------------------------------------------------------

*.local
*.local.*

# Keep example environment files
!.env.example
!.env.example.*


# ------------------------------------------------------------
# Docker Local Overrides
# ------------------------------------------------------------

docker-compose.override.yml
docker-compose.local.yml


# ------------------------------------------------------------
# Database Local Files
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------
# Generated Documentation / Reports
# ------------------------------------------------------------

reports/generated/
docs/generated/


# ------------------------------------------------------------
# Temporary Archives / Backup Files
# ------------------------------------------------------------

*.bak
*.backup
*.old
*.orig